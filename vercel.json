{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "kosmetikamamka.vercel.app"
        }
      ],
      "destination": "https://www.peceprovas.cz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kosmetikamamka.vercel.app"
        }
      ],
      "destination": "https://www.peceprovas.cz/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/soukromi", "destination": "/soukromi.html" },
    { "source": "/soukromi/", "destination": "/soukromi.html" }
  ]
}
